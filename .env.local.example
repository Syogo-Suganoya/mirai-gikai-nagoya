# Google AI Studio / Gemini API key
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# DB(管理画面と議案データ)。未設定のときは、公開サイトは静的データで動き、管理画面は使えない
# ローカル: npm run db:up で起動する Docker の PostgreSQL なら
#   postgres://postgres:postgres@127.0.0.1:5439/mirai_gikai
# 本番: Neon の接続文字列(-pooler が付いた URL)。手順は _memo/DEPLOY.md
DATABASE_URL=
