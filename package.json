    "generate:furigana": "tsx scripts/generate-explanation-furigana.ts",
    "ingest:agendas": "tsx scripts/ingest-agendas.ts",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
